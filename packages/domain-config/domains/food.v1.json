  "ui": {
    "schemaVersion": "a2ui.v0_9",
    "defaultScreen": "overview",
    "screens": {
      "overview": {
        "title": "Today",
        "subtitle": "A living kitchen cockpit: decide dinner, use what matters, keep shopping tiny.",
        "components": [
          {
            "kind": "widget",
            "widget": "postCard",
            "id": "food_ai_brief",
            "title": "Wonder brief",
            "subtitle": "Tonight’s kitchen read",
            "tone": "plum",
            "props": {
              "body": "Cook from what is already open, pick one dinner path, and buy only the missing garnish.",
              "author": "Wonder"
            }
          },
          {
            "kind": "widget",
            "widget": "pollCard",
            "id": "dinner_vote",
            "title": "Dinner direction",
            "subtitle": "One-tap family choice. Approval-backed writes come next.",
            "tone": "moss",
            "props": {
              "options": [
                {
                  "label": "Quick dal bowl",
                  "subtitle": "Use spinach and yogurt first."
                },
                {
                  "label": "Tandoori sheet pan",
                  "subtitle": "Best if chicken is already thawed."
                },
                {
                  "label": "Leftovers remix",
                  "subtitle": "Fastest and lowest waste."
                }
              ]
            }
          },
          {
            "kind": "widget",
            "widget": "chartBlock",
            "id": "food_signal_chart",
            "title": "Kitchen signal",
            "subtitle": "Tiny overview instead of a wall of rows.",
            "tone": "blue",
            "props": {
              "points": [
                {
                  "label": "Ready",
                  "value": 8
                },
                {
                  "label": "Use first",
                  "value": 3
                },
                {
                  "label": "Buy",
                  "value": 2
                }
              ]
            }
          },
          {
            "kind": "recordList",
            "id": "today_plan",
            "title": "Tonight",
            "tone": "moss",
            "subtitle": "Best next meal from plans and recipes.",
            "query": {
              "collections": [
                "meal_plan",
                "recipe"
              ],
              "match": "planned|tonight|dinner",
              "limit": 1
            },
            "action": {
              "kind": "propose",
              "label": "Choose dinner",
              "command": "choose_dinner",
              "payload": {
                "route": "/chat"
              }
            }
          },
          {
            "kind": "recordList",
            "id": "use_first",
            "title": "Use first",
            "tone": "amber",
            "subtitle": "Waste less by using what should expire soon.",
            "query": {
              "collections": [
                "inventory",
                "inventory_lot",
                "ingredient"
              ],
              "match": "use in|use soon|expire|best by|use by|open",
              "limit": 5
            },
            "action": {
              "kind": "propose",
              "label": "Plan around it",
              "command": "plan_around_use_first",
              "payload": {
                "route": "/chat"
              }
            }
          },
          {
            "kind": "recordList",
            "id": "shopping_preview",
            "title": "Still needed",
            "tone": "neutral",
            "subtitle": "Your kitchen covers what you need.",
            "query": {
              "collections": [
                "shopping_item",
                "shopping_demand",
                "shopping_list"
              ],
              "match": "to buy|needed|shopping|cart|demand",
              "limit": 3
            },
            "action": {
              "kind": "propose",
              "label": "Add an item",
              "command": "add_shopping_item",
              "payload": {
                "route": "/capture"
              }
            }
          },
          {
            "kind": "recordList",
            "id": "review_queue",
            "title": "Review queue",
            "tone": "moss",
            "subtitle": "Uncertain changes awaiting review.",
            "query": {
              "collections": [
                "purchase",
                "shopping_demand",
                "audit_event"
              ],
              "match": "review|needs|draft|pending",
              "limit": 3
            },
            "action": {
              "kind": "propose",
              "label": "Review with Wonder",
              "command": "review_food_queue",
              "payload": {
                "route": "/chat"
              }
            }
          },
          {
            "kind": "widget",
            "widget": "kanbanBoard",
            "id": "food_flow_board",
            "title": "Food flow",
            "subtitle": "Meal work as a soft board: decide, prep, buy, done.",
            "tone": "amber",
            "props": {
              "columns": [
                {
                  "title": "Decide",
                  "items": [
                    {
                      "title": "Pick dinner"
                    }
                  ]
                },
                {
                  "title": "Prep",
                  "items": [
                    {
                      "title": "Use open yogurt"
                    }
                  ]
                },
                {
                  "title": "Buy",
                  "items": [
                    {
                      "title": "Only missing garnish"
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      "kitchen": {
        "title": "Kitchen",
        "subtitle": "What you have and what should move first.",
        "components": [
          {
            "kind": "recordList",
            "id": "use_first_kitchen",
            "title": "Use first",
            "tone": "amber",
            "subtitle": "Shelf life and movement-aware priorities.",
            "query": {
              "collections": [
                "inventory",
                "inventory_lot",
                "ingredient"
              ],
              "match": "use in|use soon|expire|best by|use by|open",
              "limit": 5
            },
            "action": {
              "kind": "propose",
              "label": "Plan around it",
              "command": "replan_kitchen_priority",
              "payload": {
                "route": "/chat"
              }
            }
          },
          {
            "kind": "recordList",
            "id": "pantry",
            "title": "Pantry and fridge",
            "tone": "neutral",
            "subtitle": "Your kitchen is ready to fill.",
            "query": {
              "collections": [
                "inventory",
                "inventory_lot",
                "product"
              ],
              "limit": 8
            },
            "action": {
              "kind": "propose",
              "label": "Add food",
              "command": "add_food_item",
              "payload": {
                "route": "/capture"
              }
            }
          }
        ]
      },
      "plan": {
        "title": "Plan",
        "subtitle": "Meals, recipes and memory in one view.",
        "components": [
          {
            "kind": "recordList",
            "id": "meal_plan",
            "title": "Meals and recipes",
            "tone": "neutral",
            "subtitle": "Use your pantry and preferences to build a week.",
            "query": {
              "collections": [
                "meal_plan",
                "recipe",
                "recipe_step"
              ],
              "limit": 8
            },
            "action": {
              "kind": "propose",
              "label": "Build my week",
              "command": "build_week_plan",
              "payload": {
                "route": "/chat"
              }
            }
          },
          {
            "kind": "recordList",
            "id": "cooking_memory",
            "title": "Cook smarter",
            "tone": "plum",
            "subtitle": "Keep kitchen notes close to your meals.",
            "query": {
              "collections": [
                "meal_log",
                "recipe_revision"
              ],
              "match": "memory|previous|better|note|revision",
              "limit": 2
            },
            "action": {
              "kind": "propose",
              "label": "Save a note",
              "command": "save_food_note",
              "payload": {
                "route": "/capture"
              }
            }
          }
        ]
      },
      "shop": {
        "title": "Shop",
        "subtitle": "Buy what meals and kitchen need.",
        "components": [
          {
            "kind": "recordList",
            "id": "shopping_list",
            "title": "To buy",
            "tone": "neutral",
            "subtitle": "Keep your list active and practical.",
            "query": {
              "collections": [
                "shopping_item",
                "shopping_demand",
                "shopping_list"
              ],
              "match": "to buy|needed|shopping|cart|demand",
              "limit": 10
            },
            "action": {
              "kind": "propose",
              "label": "Add an item",
              "command": "add_shopping_list_item",
              "payload": {
                "route": "/capture"
              }
            }
          },
          {
            "kind": "recordList",
            "id": "receipt_review",
            "title": "Receipts and put-away",
            "tone": "blue",
            "subtitle": "Track captured receipts and reconciliation.",
            "query": {
              "collections": [
                "purchase",
                "purchase_line"
              ],
              "match": "receipt|review|matched|purchase|line",
              "limit": 4
            },
            "action": {
              "kind": "propose",
              "label": "Capture receipt",
              "command": "capture_receipt",
              "payload": {
                "route": "/capture"
              }
            }
          }
        ]
      }
    }
  },
