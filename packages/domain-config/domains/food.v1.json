  "dashboard_blocks": [
    {
      "id": "food:tonight",
      "surface": "food.overview",
      "title": "Tonight decision",
      "subtitle": "Meal plan, recipe and next cooking step.",
      "kind": "spotlight",
      "tone": "moss",
      "size": "standard",
      "query": { "collections": ["meal_plan", "recipe"], "match": "planned|tonight|dinner|high protein", "limit": 1 },
      "href": "/chat"
    },
    {
      "id": "food:nutrition",
      "surface": "food.overview",
      "title": "Nutrition lens",
      "subtitle": "Protein, calories, fiber and serving context from rich detail.",
      "kind": "metric",
      "tone": "plum",
      "size": "wide",
      "query": { "collections": ["recipe", "recipe_revision", "meal_plan", "meal_consumption", "nutrition_profile", "nutrition_observation", "nutrition_goal"], "match": "protein|nutrition|fiber|calorie|serving|goal", "limit": 2 },
      "href": "/search"
    },
    {
      "id": "food:lots",
      "surface": "food.kitchen",
      "title": "Lots and movements",
      "subtitle": "Open packages, expiry, purchase source and consumption/waste ledger.",
      "kind": "list",
      "tone": "moss",
      "size": "wide",
      "query": { "collections": ["inventory_lot", "inventory_movement", "product"], "match": "open|sealed|frozen|depleted|waste|expiry|lot", "limit": 4 },
      "href": "/search"
    },
    {
      "id": "food:use-soon",
      "surface": "food.kitchen",
      "title": "Use-first queue",
      "subtitle": "Food most likely to expire or unlock a planned meal.",
      "kind": "list",
      "tone": "amber",
      "size": "standard",
      "query": { "collections": ["inventory", "inventory_lot", "ingredient"], "match": "use soon|expire|pantry|available|yogurt|best by|use by", "limit": 4 },
      "href": "/capture"
    },
    {
      "id": "food:shopping",
      "surface": "food.shopping",
      "title": "Shopping gaps",
      "subtitle": "Needed, in cart, bought and why each item exists.",
      "kind": "list",
      "tone": "blue",
      "size": "standard",
      "query": { "collections": ["shopping_list", "shopping_item", "shopping_demand", "purchase_line", "purchase"], "match": "to buy|shopping|needed|missing|demand|cart", "limit": 4 },
      "href": "/capture"
    },
    {
      "id": "food:spending",
      "surface": "food.shopping",
      "title": "Spend and receipt health",
      "subtitle": "Purchase totals, line prices, returns and category/waste signals.",
      "kind": "metric",
      "tone": "plum",
      "size": "standard",
      "query": { "collections": ["purchase", "purchase_line", "inventory_movement"], "match": "total|tax|discount|merchant|waste|return|price", "limit": 3 },
      "href": "/sources"
    },
    {
      "id": "food:sources",
      "surface": "food.overview",
      "title": "Source trust",
      "subtitle": "Notion, Sheets, SQLite and Postgres feed one canonical graph.",
      "kind": "action",
      "tone": "neutral",
      "size": "compact",
      "query": { "collections": ["source_record"], "match": "notion|sheets|sqlite|postgres", "limit": 3 },
      "href": "/sources"
    }
  ],
  "mobile_surface": {
    "title": "Food",
    "subtitle": "Dinner, kitchen and shopping in one place.",
    "card_density": "compact",
    "default_view": "today",
    "views": [
      {
        "id": "today",
        "label": "Today",
        "icon": "☀",
        "title": "Today",
        "subtitle": "Dinner first. Waste less. Buy only what you need.",
        "card_order": ["today_plan", "use_first", "shopping_preview", "review_queue"]
      },
      {
        "id": "kitchen",
        "label": "Kitchen",
        "icon": "🥬",
        "title": "Kitchen",
        "subtitle": "What you have and what should move first.",
        "card_order": ["use_first", "pantry"]
      },
      {
        "id": "plan",
        "label": "Plan",
        "icon": "▦",
        "title": "Meal plan",
        "subtitle": "Meals, recipes and memory in one connected view.",
        "card_order": ["meal_plan", "cooking_memory"]
      },
      {
        "id": "shop",
        "label": "Shop",
        "icon": "🛒",
        "title": "Shopping",
        "subtitle": "Buy only what your meals and kitchen need.",
        "card_order": ["shopping_list", "receipt_review"]
      }
    ],
    "card_order": ["today_plan", "use_first", "shopping_preview", "review_queue"],
    "cards": [
      {
        "id": "today_plan",
        "kind": "spotlight",
        "label": "Tonight",
        "icon": "🍲",
        "tone": "moss",
        "query": { "collections": ["meal_plan", "recipe"], "match": "planned|tonight|dinner", "limit": 1 },
        "empty": { "title": "Choose dinner in a minute", "detail": "Wonder can use what is already in your kitchen." },
        "nested": [
          {
            "id": "tonight_use_first",
            "label": "Use first",
            "query": { "collections": ["inventory", "inventory_lot", "ingredient"], "match": "use in|use soon|expire|best by|use by|open", "limit": 1 },
            "empty": "Nothing urgent"
          },
          {
            "id": "tonight_missing",
            "label": "Still needed",
            "query": { "collections": ["shopping_item", "shopping_demand"], "match": "to buy|needed|missing|demand", "limit": 1 },
            "empty": "Kitchen looks ready"
          }
        ],
        "action": { "label": "Choose dinner", "href": "/chat" }
      },
      {
        "id": "review_queue",
        "kind": "review",
        "label": "Review queue",
        "icon": "✓",
        "tone": "moss",
        "query": { "collections": ["purchase", "shopping_demand", "audit_event"], "match": "review|needs|draft|pending", "limit": 3 },
        "empty": { "title": "Nothing waiting for review", "detail": "Wonder will hold uncertain changes here before saving." },
        "nested": [],
        "action": { "label": "Review with Wonder", "href": "/chat" }
      },
      {
        "id": "ai_nudge",
        "kind": "assistant",
        "label": "Wonder noticed",
        "icon": "✦",
        "tone": "blue",
        "query": { "collections": ["inventory", "inventory_lot", "shopping_demand"], "match": "use in|use soon|open|best by|needed|demand", "limit": 1 },
        "empty": { "title": "Your food is in a good place", "detail": "Wonder will surface useful connections, never busywork." },
        "nested": [
          {
            "id": "works_with",
            "label": "Works with",
            "query": { "collections": ["recipe", "meal_plan"], "match": "planned|tonight|dinner|recipe", "limit": 1 },
            "empty": "Ask for an idea"
          }
        ],
        "action": { "label": "Turn this into a meal", "href": "/chat" }
      },
      {
        "id": "use_first",
        "kind": "spotlight",
        "label": "Use first",
        "icon": "⏳",
        "tone": "amber",
        "query": { "collections": ["inventory", "inventory_lot", "ingredient"], "match": "use in|use soon|expire|best by|use by|open", "limit": 1 },
        "empty": { "title": "Nothing needs rescuing", "detail": "Your freshness queue is clear." },
        "nested": [
          {
            "id": "use_it_in",
            "label": "Use it in",
            "query": { "collections": ["recipe", "meal_plan"], "match": "planned|dinner|recipe", "limit": 1 },
            "empty": "Any easy meal"
          }
        ],
        "action": { "label": "Plan around it", "href": "/chat" }
      },
      {
        "id": "shopping_preview",
        "kind": "list",
        "label": "Still needed",
        "icon": "🛒",
        "tone": "neutral",
        "query": { "collections": ["shopping_item", "shopping_demand", "shopping_list"], "match": "to buy|needed|shopping|cart|demand", "limit": 3 },
        "empty": { "title": "Nothing to buy", "detail": "Your kitchen covers the plan." },
        "nested": [],
        "action": { "label": "Add an item", "href": "/capture" }
      },
      {
        "id": "pantry",
        "kind": "list",
        "label": "Pantry and fridge",
        "icon": "🥬",
        "tone": "neutral",
        "query": { "collections": ["inventory", "inventory_lot", "product"], "limit": 8 },
        "empty": { "title": "Your kitchen is ready to fill", "detail": "Add a food, scan a receipt or connect your existing list." },
        "nested": [],
        "action": { "label": "Add food", "href": "/capture" }
      },
      {
        "id": "meal_plan",
        "kind": "list",
        "label": "Meals and recipes",
        "icon": "▦",
        "tone": "neutral",
        "query": { "collections": ["meal_plan", "recipe", "recipe_step"], "limit": 8 },
        "empty": { "title": "No plan yet", "detail": "Wonder can draft a week from your pantry and preferences." },
        "nested": [],
        "action": { "label": "Build my week", "href": "/chat" }
      },
      {
        "id": "cooking_memory",
        "kind": "assistant",
        "label": "Cook smarter",
        "icon": "✦",
        "tone": "plum",
        "query": { "collections": ["meal_log", "recipe_revision"], "match": "memory|previous|better|note|revision", "limit": 1 },
        "empty": { "title": "Your kitchen will learn", "detail": "Useful notes from meals you cook appear here." },
        "nested": [
          {
            "id": "already_home",
            "label": "At home",
            "query": { "collections": ["inventory", "inventory_lot"], "match": "available|open|pantry|use in", "limit": 1 },
            "empty": "Add pantry items"
          }
        ],
        "action": { "label": "Save a note", "href": "/capture" }
      },
      {
        "id": "shopping_list",
        "kind": "list",
        "label": "To buy",
        "icon": "🛒",
        "tone": "neutral",
        "query": { "collections": ["shopping_item", "shopping_demand", "shopping_list"], "match": "to buy|needed|shopping|cart|demand", "limit": 10 },
        "empty": { "title": "Your list is clear", "detail": "Wonder can compare a meal plan with your kitchen." },
        "nested": [],
        "action": { "label": "Add an item", "href": "/capture" }
      },
      {
        "id": "receipt_review",
        "kind": "review",
        "label": "Receipts and put-away",
        "icon": "🧾",
        "tone": "blue",
        "query": { "collections": ["purchase", "purchase_line"], "match": "receipt|review|matched|purchase|line", "limit": 4 },
        "empty": { "title": "No receipts waiting", "detail": "Captured receipts become reviewable pantry updates." },
        "nested": [],
        "action": { "label": "Capture receipt", "href": "/capture" }
      }
    ],
    "advanced": {
      "visible": false,
      "cards": [
        {
          "id": "source_provenance",
          "kind": "list",
          "label": "Source and provenance",
          "icon": "🔗",
          "tone": "neutral",
          "query": { "collections": ["source_record", "audit_event"], "limit": 4 },
          "empty": { "title": "No source detail loaded", "detail": "Connect or inspect data homes here." },
          "nested": [],
          "action": { "label": "Open sources", "href": "/sources" }
        },
        {
          "id": "package_controls",
          "kind": "spotlight",
          "label": "Package controls",
          "icon": "⚙",
          "tone": "neutral",
          "query": { "collections": ["audit_event"], "limit": 1 },
          "empty": { "title": "Advanced setup", "detail": "Package and debug controls stay hidden by default." },
          "nested": [],
          "action": { "label": "Open settings", "href": "/settings" }
        }
      ]
    }
  },
